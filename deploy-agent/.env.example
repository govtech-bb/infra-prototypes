# Copy this file to .env and fill in real values. .env is gitignored.
# `./run.sh` auto-loads .env on startup.

# Required — Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# AWS credentials — set ONE of the following:
#   1. A named profile from ~/.aws/credentials
AWS_PROFILE=your-profile-name
#   2. Or static keys (uncomment and set):
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=us-east-1

# Optional — override the SQLite session DB path (default: ./data/sessions.db)
# DEPLOY_AGENT_DB=/tmp/deploy-agent-sessions.db
